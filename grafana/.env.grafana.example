# Copiar a /home/ubuntu/.env.grafana en la EC2 y rellenar con los valores reales.
# El archivo real NO se versiona: solo se versiona esta plantilla.
#
# Permisos recomendados en la EC2 (Grafana lo lee como EnvironmentFile):
#   sudo chown ubuntu:grafana /home/ubuntu/.env.grafana
#   sudo chmod 640 /home/ubuntu/.env.grafana

# --- InfluxDB (token de SOLO lectura para Grafana) ---
INFLUX_URL=http://10.0.2.116:8086
INFLUX_ORG=uao
INFLUX_BUCKET=racks
INFLUX_TOKEN=pega_aqui_el_token_de_lectura

# --- Bot de Telegram de las alertas ---
TELEGRAM_BOT_TOKEN=123456789:pega_aqui_el_token_del_bot
TELEGRAM_CHAT_ID=pega_aqui_el_chat_id

# --- Contraseña del usuario admin de Grafana ---
GF_SECURITY_ADMIN_PASSWORD=cambia_esta_clave
