# Copiar como ".env" y completar. El archivo .env NO se sube a GitHub.

# Mosquitto (corre en la misma EC2)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=ingestor
MQTT_PASS=

# InfluxDB (EC2 en la subred privada)
INFLUX_URL=http://10.0.2.XX:8086
INFLUX_TOKEN=
INFLUX_ORG=uao
INFLUX_BUCKET=racks

# Archivo CSV
CSV_PATH=/var/lib/ingestor/datos.csv
